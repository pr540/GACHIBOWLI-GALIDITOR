# ---------------------------------------------------------------------------
# SplitBills environment. Copy to .env and fill in.
# Everything below has a working local default except the OAuth/AI secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Local: docker compose up -d. Prod: Neon / Supabase / any Postgres 17 + pgvector.
DATABASE_URL=postgresql://splitbills:splitbills@localhost:5432/splitbills

# --- Cache & queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-random
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Optional OAuth providers. Leave blank to disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- API ------------------------------------------------------------------
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Object storage (R2 / S3 / MinIO) -------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=splitbills
STORAGE_ACCESS_KEY_ID=splitbills
STORAGE_SECRET_ACCESS_KEY=splitbills

# --- FX rates -------------------------------------------------------------
# Self-hosted Frankfurter by default; use https://api.frankfurter.dev/v1 for hosted.
FX_API_URL=http://localhost:8080/v1

# --- AI (all optional; features degrade gracefully when unset) ------------
# Provider-agnostic. One of: google | openai | anthropic | ollama
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
# Only for AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings for semantic search / duplicate detection.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# --- Email ----------------------------------------------------------------
# Resend by default; falls back to SMTP when RESEND_API_KEY is blank.
RESEND_API_KEY=
EMAIL_FROM=SplitBills <noreply@localhost>
SMTP_URL=

# --- Observability (optional) ---------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
