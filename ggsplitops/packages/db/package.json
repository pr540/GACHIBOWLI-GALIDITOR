{
  "name": "@splitbills/db",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, client, and migrations for SplitBills.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
